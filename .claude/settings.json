{
  "permissions": {
    "allow": [
      "mcp__sre__list_alerts",
      "mcp__sre__get_logs",
      "mcp__sre__get_metrics",
      "mcp__sre__get_deploys",
      "mcp__sre__get_runbook",
      "Bash(npm test)",
      "PowerShell(npm test)",
      "Bash(npm run eval)",
      "PowerShell(npm run eval)",
      "Bash(npm run eval -- *)",
      "PowerShell(npm run eval -- *)",
      "Bash(npm run test:hooks)",
      "PowerShell(npm run test:hooks)",
      "Bash(npm run progress)",
      "PowerShell(npm run progress)",
      "Bash(npm run skill:scan -- *)",
      "PowerShell(npm run skill:scan -- *)",
      "Bash(git status)",
      "PowerShell(git status)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git switch -c fix/*)",
      "PowerShell(git switch -c fix/*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "PowerShell(curl *)",
      "Bash(wget *)",
      "PowerShell(wget *)",
      "Bash(ssh *)",
      "PowerShell(ssh *)",
      "Bash(npm run approve*)",
      "PowerShell(npm run approve*)",
      "Bash(node scripts/approve*)",
      "PowerShell(node scripts/approve*)",
      "Bash(scripts/approve*)",
      "PowerShell(scripts/approve*)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(glab mr merge*)",
      "PowerShell(glab mr merge*)",
      "Bash(glab mr approve*)",
      "PowerShell(glab mr approve*)",
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Edit(./approvals/**)",
      "Edit(./.claude/**)",
      "Edit(./progress.md)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "sre"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__sre__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/progress.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/progress.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/progress.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "disableSkillShellExecution": true
}
